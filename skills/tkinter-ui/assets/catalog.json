{
  "format": "tkui-spec",
  "schema_version": 1,
  "styles": {
    "web": "现代 Web 应用风（TkWebUI）",
    "win11": "Windows 11 Fluent（TkWin11）"
  },
  "icons": [
    "plus",
    "search",
    "edit",
    "play",
    "check",
    "library",
    "sources",
    "settings",
    "controls",
    "folder",
    "download",
    "back",
    "speed",
    "pin",
    "chevronup",
    "chevrondown",
    "chevronright",
    "collapse",
    "expand",
    "info"
  ],
  "aliases": {
    "stack": "column",
    "vstack": "column",
    "frame": "column",
    "hstack": "row",
    "toolbar": "row",
    "divider": "separator",
    "listbox": "list",
    "combobox": "combo",
    "select": "combo",
    "text_input": "entry",
    "input": "entry",
    "textarea": "text",
    "radio": "radio_group",
    "switch_group": "radio_group",
    "figure": "chart",
    "datatable": "table",
    "data_table": "table",
    "grid_table": "tree"
  },
  "common_props": {
    "id": {
      "kind": "str",
      "desc": "组件 id，用于 app['id'] / app.get('id')，必须唯一"
    },
    "variable": {
      "kind": "str",
      "desc": "共享 Tk 变量名；同名控件自动共享状态"
    },
    "tooltip": {
      "kind": "str",
      "desc": "悬停提示"
    },
    "enabled": {
      "kind": "bool",
      "default": true,
      "desc": "是否可用"
    }
  },
  "layout_fields": {
    "side": {
      "kind": "enum",
      "values": [
        "top",
        "bottom",
        "left",
        "right"
      ],
      "desc": "pack 方向"
    },
    "fill": {
      "kind": "enum",
      "values": [
        "x",
        "y",
        "both",
        "none"
      ],
      "desc": "填充方向"
    },
    "expand": {
      "kind": "bool",
      "desc": "是否占用剩余空间"
    },
    "padx": {
      "kind": "int",
      "desc": "水平外边距（可写 [左, 右]）"
    },
    "pady": {
      "kind": "int",
      "desc": "垂直外边距（可写 [上, 下]）"
    },
    "ipadx": {
      "kind": "int",
      "desc": "水平内边距"
    },
    "ipady": {
      "kind": "int",
      "desc": "垂直内边距"
    },
    "anchor": {
      "kind": "enum",
      "values": [
        "n",
        "s",
        "e",
        "w",
        "center",
        "ne",
        "nw",
        "se",
        "sw"
      ],
      "desc": "对齐点"
    },
    "row": {
      "kind": "int",
      "desc": "grid 行（grid 父容器内）"
    },
    "column": {
      "kind": "int",
      "desc": "grid 列（grid 父容器内）"
    },
    "rowspan": {
      "kind": "int",
      "desc": "grid 跨行"
    },
    "columnspan": {
      "kind": "int",
      "desc": "grid 跨列"
    },
    "sticky": {
      "kind": "str",
      "desc": "grid 拉伸，如 nsew"
    },
    "weightx": {
      "kind": "int",
      "desc": "grid 列权重"
    },
    "weighty": {
      "kind": "int",
      "desc": "grid 行权重"
    },
    "width": {
      "kind": "int",
      "desc": "固定宽度"
    },
    "height": {
      "kind": "int",
      "desc": "固定高度"
    }
  },
  "events": {
    "click": "点击",
    "change": "值变化",
    "select": "选择变化（表格/图表/列表）",
    "activate": "双击/回车激活"
  },
  "components": {
    "column": {
      "name": "column",
      "category": "布局",
      "summary": "纵向堆叠容器（默认填充 x）。",
      "container": true,
      "children": "任意非 tab 组件",
      "props": {
        "gap": {
          "kind": "int",
          "desc": "子项间距",
          "default": 8
        },
        "padding": {
          "kind": "int",
          "desc": "容器内边距",
          "default": 0
        },
        "surface": {
          "kind": "enum",
          "desc": "背景面",
          "default": "panel",
          "values": [
            "panel",
            "workspace",
            "sidebar"
          ]
        }
      },
      "events": [],
      "styles": [
        "web",
        "win11"
      ],
      "fallback": null,
      "default_layout": {},
      "example": {
        "type": "column",
        "gap": 12,
        "children": []
      },
      "notes": null
    },
    "row": {
      "name": "row",
      "category": "布局",
      "summary": "横向排列容器，子项默认垂直填充。",
      "container": true,
      "children": "任意非 tab 组件",
      "props": {
        "gap": {
          "kind": "int",
          "desc": "子项间距",
          "default": 8
        },
        "padding": {
          "kind": "int",
          "desc": "容器内边距",
          "default": 0
        },
        "align": {
          "kind": "enum",
          "desc": "子项对齐",
          "default": "center",
          "values": [
            "center",
            "start",
            "end",
            "stretch"
          ]
        },
        "surface": {
          "kind": "enum",
          "desc": "背景面",
          "default": "panel",
          "values": [
            "panel",
            "workspace",
            "sidebar"
          ]
        }
      },
      "events": [],
      "styles": [
        "web",
        "win11"
      ],
      "fallback": null,
      "default_layout": {},
      "example": {
        "type": "row",
        "gap": 8,
        "children": []
      },
      "notes": null
    },
    "grid": {
      "name": "grid",
      "category": "布局",
      "summary": "网格容器；子项用 layout.row / layout.column 指定位置。",
      "container": true,
      "children": "任意非 tab 组件",
      "props": {
        "gap": {
          "kind": "int",
          "desc": "子项间距",
          "default": 8
        },
        "padding": {
          "kind": "int",
          "desc": "容器内边距",
          "default": 0
        },
        "columns": {
          "kind": "int",
          "desc": "未指定位置时自动排列的列数",
          "default": 2
        },
        "surface": {
          "kind": "enum",
          "desc": "背景面",
          "default": "panel",
          "values": [
            "panel",
            "workspace",
            "sidebar"
          ]
        }
      },
      "events": [],
      "styles": [
        "web",
        "win11"
      ],
      "fallback": null,
      "default_layout": {},
      "example": {
        "type": "grid",
        "columns": 2,
        "children": []
      },
      "notes": null
    },
    "spacer": {
      "name": "spacer",
      "category": "布局",
      "summary": "固定或弹性空白。",
      "container": false,
      "children": null,
      "props": {
        "size": {
          "kind": "int",
          "desc": "空白尺寸",
          "default": 8
        },
        "expand": {
          "kind": "bool",
          "desc": "是否吸收剩余空间",
          "default": false
        }
      },
      "events": [],
      "styles": [
        "web",
        "win11"
      ],
      "fallback": null,
      "default_layout": {},
      "example": {
        "type": "spacer",
        "size": 12
      },
      "notes": null
    },
    "separator": {
      "name": "separator",
      "category": "布局",
      "summary": "分隔线。",
      "container": false,
      "children": null,
      "props": {
        "orient": {
          "kind": "enum",
          "desc": "方向",
          "default": "horizontal",
          "values": [
            "horizontal",
            "vertical"
          ]
        }
      },
      "events": [],
      "styles": [
        "web",
        "win11"
      ],
      "fallback": null,
      "default_layout": {},
      "example": {
        "type": "separator"
      },
      "notes": null
    },
    "scroll": {
      "name": "scroll",
      "category": "布局",
      "summary": "可滚动区域，内容放在 body 中。",
      "container": true,
      "children": null,
      "props": {
        "height": {
          "kind": "int",
          "desc": "建议高度",
          "default": 320
        },
        "gap": {
          "kind": "int",
          "desc": "子项间距",
          "default": 10
        },
        "padding": {
          "kind": "int",
          "desc": "内容内边距",
          "default": 0
        }
      },
      "events": [],
      "styles": [
        "web",
        "win11"
      ],
      "fallback": null,
      "default_layout": {
        "fill": "both",
        "expand": true
      },
      "example": {
        "type": "scroll",
        "height": 360,
        "children": []
      },
      "notes": null
    },
    "page": {
      "name": "page",
      "category": "布局",
      "summary": "页面：标题 + 可滚动内容。通常只出现在 pages 下。",
      "container": true,
      "children": null,
      "props": {
        "title": {
          "kind": "str",
          "desc": "页面标题"
        },
        "subtitle": {
          "kind": "str",
          "desc": "页面副标题"
        },
        "scroll": {
          "kind": "bool",
          "desc": "内容是否可滚动",
          "default": true
        },
        "padding": {
          "kind": "int",
          "desc": "内容内边距",
          "default": 24
        },
        "gap": {
          "kind": "int",
          "desc": "内容间距",
          "default": 14
        }
      },
      "events": [],
      "styles": [
        "web",
        "win11"
      ],
      "fallback": null,
      "default_layout": {
        "fill": "both",
        "expand": true
      },
      "example": {
        "type": "page",
        "title": "概览",
        "children": []
      },
      "notes": null
    },
